# Sandbox credentials for the PayPal app with Transaction Search enabled.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
DATABASE_URL=postgres://finsig:finsig_dev@127.0.0.1:5432/finsig

# Optional delegated merchant probe; not used in the current first-party gate.
PAYPAL_CONSENTED_MERCHANT_ID=
PAYPAL_PARTNER_CONSENT_CONFIRMED=false
PAYPAL_PARTNER_ATTRIBUTION_ID=

# Optional RFC3339 dates, at most 31 days apart.
PAYPAL_PROBE_START_DATE=
PAYPAL_PROBE_END_DATE=
